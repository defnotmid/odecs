// FNV-1a 64 of libjpeg-turbo's RGBA8 for BASELINE (djpeg at its defaults).
@(private = "file")
TURBO_HASH :: 0xa0d60685b14f9169

@(private = "file")
fnv :: proc(b: []u8) -> u64 {
	h: u64 = 0xcbf29ce484222325
	for v in b {
		h ~= u64(v)
		h *= 0x100000001b3
	}
	return h
}

@(test)
baseline_and_progressive_match_libjpeg_turbo :: proc(t: ^testing.T) {
	for data, k in ([2][]u8{BASELINE[:], PROGRESSIVE[:]}) {
		ft, ferr := get_features(data)
		testing.expect_value(t, ferr, Error.None)
		testing.expect_value(t, ft, Features{23, 13, 3, k == 1})
		img, err := decode(data)
		defer destroy_image(&img)
		testing.expect_value(t, err, Error.None)
		testing.expectf(t, fnv(img.pixels) == TURBO_HASH, "file %d: hash %x", k, fnv(img.pixels))
	}
}

// The same IDCT arithmetic, one sample at a time, against the lanes.
@(private = "file")
reference_idct :: proc(block: ^[64]i16, quant: ^[64]u16) -> (out: [64]u8) {
	descale :: proc(x: i64, n: uint) -> i64 {return (x + 1 << (n - 1)) >> n}
	pass :: proc(s: [8]i64) -> (x: [8]i64) {
		z1 := (s[2] + s[6]) * 4433
		t2, t3 := z1 + s[6] * -15137, z1 + s[2] * 6270
		t0, t1 := (s[0] + s[4]) << 13, (s[0] - s[4]) << 13
		e := [4]i64{t0 + t3, t1 + t2, t1 - t2, t0 - t3}
		a0, a1, a2, a3 := s[7], s[5], s[3], s[1]
		z5 := (a0 + a2 + a1 + a3) * 9633
		q1, q2 := (a0 + a3) * -7373, (a1 + a2) * -20995
		q3, q4 := (a0 + a2) * -16069 + z5, (a1 + a3) * -3196 + z5
		o := [4]i64{a0 * 2446 + q1 + q3, a1 * 16819 + q2 + q4, a2 * 25172 + q2 + q3, a3 * 12299 + q1 + q4}
		for i in 0 ..< 4 {
			x[i] = e[i] + o[3 - i]
			x[7 - i] = e[i] - o[3 - i]
		}
		return
	}
	work: [64]i64
	for col in 0 ..< 8 {
		s: [8]i64
		for r in 0 ..< 8 do s[r] = i64(block[r * 8 + col]) * i64(quant[r * 8 + col])
		x := pass(s)
		for r in 0 ..< 8 do work[r * 8 + col] = descale(x[r], 11)
	}
	for row in 0 ..< 8 {
		x := pass([8]i64{work[row * 8], work[row * 8 + 1], work[row * 8 + 2], work[row * 8 + 3], work[row * 8 + 4], work[row * 8 + 5], work[row * 8 + 6], work[row * 8 + 7]})
		for c in 0 ..< 8 do out[row * 8 + c] = u8(clamp(descale(x[c], 18) + 128, 0, 255))
	}
	return
}

@(test)
idct_matches_scalar :: proc(t: ^testing.T) {
	quant: [64]u16
	for &q in quant do q = u16(1 + rand.int_max(40))
	for n in 0 ..< 2000 {
		block: [64]i16
		// Dense, sparse and DC-only blocks, dequantized within the +-1024 an
		// 8-bit image's DCT spans.
		count := n % 3 == 0 ? 1 : n % 3 == 1 ? 6 : 64
		for _ in 0 ..< count {
			at := n % 3 == 0 ? 0 : rand.int_max(64)
			block[at] = i16((rand.int_max(2048) - 1024) / int(quant[at]))
		}
		out: [64]u8
		idct_block(out[:], 8, &block, &quant)
		want := reference_idct(&block, &quant)
		if out != want {
			testing.expectf(t, false, "block %d: %v, want %v", n, out, want)
			return
		}
	}
}

// Every truncation of a file is decoded or refused, never read past.
@(test)
truncated_input :: proc(t: ^testing.T) {
	for data in ([2][]u8{BASELINE[:], PROGRESSIVE[:]}) {
		for n in 0 ..< len(data) {
			if img, err := decode(data[:n]); err == .None do destroy_image(&img)
		}
	}
}
