package main

import "core:strings"

// webp/tables.odin: normative data of VP8 (RFC 6386) and WebP
// lossless, from libwebp's decoder:
//   - tree_dec.c: the default coefficient probabilities, their update
//     probabilities, and the 4x4 intra mode probabilities by the modes above
//     and to the left (libwebp's mode order: DC, TM, VE, HE, RD, VR, LD, VL,
//     HD, HU);
//   - quant_dec.c: the DC and AC quantizer steps by index;
//   - vp8l_dec.c: the lossless distance map (the 120 nearest neighbours of a
//     pixel as (y << 4) | (8 - x)).
webp_tables :: proc(out: ^strings.Builder, third_party: string) {
	dir := strings.concatenate({third_party, "/libwebp/src/dec/"})
	src := strings.join({read(strings.concatenate({dir, "tree_dec.c"})), read(strings.concatenate({dir, "quant_dec.c"})), read(strings.concatenate({dir, "vp8l_dec.c"}))}, "\n")

	strings.write_string(out, "// Generated by tools/tables from third_party/libwebp (libwebp 1.6.0,\n")
	strings.write_string(out, "// BSD-3-Clause); do not edit.\npackage webp\n\n")
	ATTRIBUTES :: "private, rodata"
	nested_table(out, ATTRIBUTES, "COEFF_PROBS", "u8", c_ints(src, "CoeffsProba0"), {4, 8, 3, 11}, {"Default coefficient probabilities by block type, band, context and token node."})
	nested_table(out, ATTRIBUTES, "COEFF_UPDATE_PROBS", "u8", c_ints(src, "CoeffsUpdateProba"), {4, 8, 3, 11}, {"Probabilities that the frame header updates each coefficient probability."})
	nested_table(out, ATTRIBUTES, "BMODE_PROBS", "u8", c_ints(src, "kBModesProba"), {10, 10, 9}, {"4x4 intra mode tree probabilities by the mode above, then the mode to the left."})
	nested_table(out, ATTRIBUTES, "DC_STEP", "u16", c_ints(src, "kDcTable"), {128}, {"DC quantizer steps by index."})
	nested_table(out, ATTRIBUTES, "AC_STEP", "u16", c_ints(src, "kAcTable"), {128}, {"AC quantizer steps by index."})
	nested_table(out, ATTRIBUTES, "DISTANCE_MAP", "u8", c_ints(src, "kCodeToPlane"), {120}, {"Lossless distance codes 1..120: (dy << 4) | (8 - dx) of the source pixel."})
}
