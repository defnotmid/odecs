package main

import "core:fmt"
import "core:slice"
import "core:strings"
import "core:unicode"
import "core:unicode/utf8"

// vp9/tables.odin from the VP9 Bitstream & Decoding Process
// Specification v0.7 (2017-02-22), the primary document:
//
//	https://storage.googleapis.com/downloads.webmproject.org/docs/vp9/vp9-bitstream-specification-v0.7-20170222-draft.pdf
//	sha256 92a5bc772d11572c2f119680998ee202e249d075469515fe43bbb7febb51b963
//	pdftotext -layout vp9-bitstream-specification-v0.7-20170222-draft.pdf spec.txt
//
// Every `name[ dims ] = { ... }` table in the text is transcribed:
// dimensions and symbolic entries resolve through the constants of section 3
// and the value tables of section 7, element counts are checked against the
// dimensions, and each table gets the narrowest integer type holding its
// values.
vp9_tables :: proc(out: ^strings.Builder, spec: string) {
	lines := make([dynamic]string)
	text := read(spec)
	for line in split_lines(&text) {
		// Page furniture interrupts tables that span pages.
		if strings.contains(line, "Copyright © 2017 Google") || strings.contains(line, "VP9 Bitstream & Decoding Process Specification") do continue
		append(&lines, line)
	}
	constants := vp9_constants(lines[:])
	joined := strings.join(lines[:], "\n")

	strings.write_string(out, "// Generated by tools/tables from the VP9 Bitstream & Decoding Process\n")
	strings.write_string(out, "// Specification v0.7 (2017-02-22). Do not edit.\npackage vp9\n\n")
	count := 0
	for i := 0; i < len(joined); i += 1 {
		name, dims, body_start, found := table_head(joined, i, constants)
		if !found do continue
		body, _ := braced(joined, body_start)
		values := table_values(strip_comments(body), dims, constants)
		total := 1
		for d in dims do total *= d
		if len(values) != total do fail("%s: %d values for dims %v", name, len(values), dims)
		// Scans share one element type so every transform size reads the same slice type.
		kind := strings.contains(name, "scan") ? "u16" : narrowest(values)
		nested_table(out, "rodata", strings.to_upper(name), kind, values, dims)
		count += 1
		i = body_start - 1 // the search goes on just inside the table, as a regex scan would
	}
	fmt.eprintfln("// %d tables", count)
}

// The lines of text, split as on any line break (form feeds between pages
// included).
split_lines :: proc(text: ^string) -> (line: string, ok: bool) {
	if len(text) == 0 do return
	for i in 0 ..< len(text) {
		switch text[i] {
		case '\n', '\r', '\v', '\f', 0x1c, 0x1d, 0x1e:
			line = text[:i]
			next := i + 1
			if text[i] == '\r' && next < len(text) && text[next] == '\n' do next += 1
			text^ = text[next:]
			return line, true
		}
	}
	line, text^ = text^, ""
	return line, true
}

upper_name :: proc(s: string, i: int) -> int {
	if i >= len(s) || s[i] < 'A' || s[i] > 'Z' do return i
	j := i + 1
	for j < len(s) && (is_digit(s[j]) || s[j] == '_' || (s[j] >= 'A' && s[j] <= 'Z')) do j += 1
	return j - i >= 2 ? j : i
}

digits_end :: proc(s: string, i: int) -> int {
	j := i
	for j < len(s) && is_digit(s[j]) do j += 1
	return j
}

// Section 3 lists `NAME value description`; the value tables of section 7
// list `value NAME [notes]`, and inter_mode's `value y_mode NAME`. The first
// definition of a name wins; section 7's are read from its heading on, so
// wrapped descriptions in section 3 cannot shadow them.
vp9_constants :: proc(lines: []string) -> map[string]i64 {
	constants := make(map[string]i64)
	define :: proc(constants: ^map[string]i64, name, value: string) {
		if name not_in constants do constants[name] = c_int(value)
	}
	semantics := -1
	for l, n in lines {
		if !strings.has_prefix(l, "7") do continue
		i := 1
		for i < len(l) && is_space(l[i]) do i += 1
		if i > 1 && strings.has_prefix(l[i:], "Bitstream semantics") do semantics = n // the last: past the contents page
	}
	expect(semantics >= 0, "section 7")
	for l, n in lines {
		// Section 3: NAME value description.
		if e := upper_name(l, 0); e > 0 && e < len(l) && is_space(l[e]) {
			v := skip_space(l, e)
			d := digits_end(l, v)
			if d > v && d < len(l) && is_space(l[d]) do define(&constants, l[:e], l[v:d])
		}
		if n < semantics do continue
		// Section 7: value NAME [notes].
		v := skip_space(l, 0)
		d := digits_end(l, v)
		if d == v || d >= len(l) || !is_space(l[d]) do continue
		s := skip_space(l, d)
		if e := upper_name(l, s); e > s && (e == len(l) || is_space(l[e])) do define(&constants, l[s:e], l[v:d])
		// inter_mode: value y_mode NAME.
		v2 := s
		d2 := digits_end(l, v2)
		if d2 == v2 || d2 >= len(l) || !is_space(l[d2]) do continue
		s2 := skip_space(l, d2)
		if e := upper_name(l, s2); e > s2 && skip_space(l, e) == len(l) do define(&constants, l[s2:e], l[v2:d2])
	}
	// Rows whose description wraps put the value on the next line.
	define(&constants, "ZERO_PLUS_PREDICTED", "1")
	// token_tree spells the categories out; section 7.4.16 abbreviates them.
	for n in 1 ..= 6 {
		category, ok := constants[fmt.tprintf("DCT_VAL_CAT%d", n)]
		expect(ok, "DCT_VAL_CAT")
		name := fmt.aprintf("DCT_VAL_CATEGORY%d", n)
		if name not_in constants do constants[name] = category
	}
	return constants
}

// A spec expression: numbers, constants, + - * and parentheses.
spec_value :: proc(text: string, constants: map[string]i64) -> i64 {
	for c in transmute([]u8)text {
		if !(is_digit(c) || (c >= 'A' && c <= 'Z') || strings.index_byte("_+-* ()\n", c) >= 0) do fail("bad expression %q", text)
	}
	return evaluate(text, constants)
}

// The table definition `name[dims]... = {` starting at i: its name, its
// dimensions and the offset just inside its brace.
table_head :: proc(s: string, i: int, constants: map[string]i64) -> (name: string, dims: []int, body: int, found: bool) {
	if s[i] < 'a' || s[i] > 'z' do return
	if i > 0 {
		r, _ := utf8.decode_last_rune_in_string(s[:i])
		if r == '_' || unicode.is_letter(r) || unicode.is_digit(r) do return
	}
	j := i
	for j < len(s) && (is_digit(s[j]) || s[j] == '_' || (s[j] >= 'a' && s[j] <= 'z')) do j += 1
	name = s[i:j]
	j = skip_space(s, j)
	dim_text := make([dynamic]string)
	for j < len(s) && s[j] == '[' {
		start := skip_space(s, j + 1)
		e := start
		for e < len(s) && (s[e] == ' ' || is_word(s[e]) || s[e] == '+' || s[e] == '-' || s[e] == '*') do e += 1
		if e == start do return
		close := skip_space(s, e)
		if close >= len(s) || s[close] != ']' do return
		append(&dim_text, s[start:e])
		j = skip_space(s, close + 1)
	}
	if len(dim_text) == 0 || j >= len(s) || s[j] != '=' do return
	j = skip_space(s, j + 1)
	if j >= len(s) || s[j] != '{' do return
	dims = make([]int, len(dim_text))
	for d, k in dim_text do dims[k] = int(spec_value(d, constants))
	return name, dims, j + 1, true
}

// The values of a table body. Nested braces give the structure, and a short
// innermost row is zero-filled, as in a C initializer (cat_probs).
table_values :: proc(body: string, dims: []int, constants: map[string]i64) -> []i64 {
	Row :: struct {
		start:  int, // the row's first value
		nested: bool, // it holds rows
	}
	values := make([dynamic]i64)
	rows := make([dynamic]Row)
	append(&rows, Row{})
	close :: proc(values: ^[dynamic]i64, row: Row, level: int, dims: []int) {
		if row.nested || level != len(dims) - 1 do return
		for len(values) < row.start + dims[level] do append(values, 0)
	}
	item := 0
	for i := 0; i <= len(body); i += 1 {
		c := i < len(body) ? body[i] : ','
		if c != '{' && c != '}' && c != ',' do continue
		if text := strings.trim_space(body[item:i]); text != "" do append(&values, spec_value(text, constants))
		item = i + 1
		switch c {
		case '{':
			rows[len(rows) - 1].nested = true
			append(&rows, Row{start = len(values)})
		case '}':
			expect(len(rows) > 1, "table braces")
			close(&values, pop(&rows), len(rows), dims)
		}
	}
	expect(len(rows) == 1, "table braces")
	close(&values, rows[0], 0, dims)
	return values[:]
}

narrowest :: proc(values: []i64) -> string {
	lo, hi, _ := slice.min_max(values)
	switch {
	case lo >= 0 && hi <= 255: return "u8"
	case lo >= -128 && hi <= 127: return "i8"
	case lo >= 0 && hi <= 65535: return "u16"
	case lo >= -32768 && hi <= 32767: return "i16"
	}
	return "i32"
}
