package main

import "core:fmt"
import "core:strings"

// h265/scan_tables.odin: the coefficient scans from Kvazaar's tables.c
// and tables.h, and the selector over them.
h265_tables :: proc(out: ^strings.Builder, third_party: string) {
	tables_c := read(strings.concatenate({third_party, "/kvazaar/src/tables.c"}))
	tables_h := read(strings.concatenate({third_party, "/kvazaar/src/tables.h"}))

	strings.write_string(out, "// Generated by tools/tables from third_party/kvazaar (BSD-3-Clause); do not edit.\n")
	strings.write_string(out, "package h265\n\n")
	strings.write_string(out, "// Coefficient scans SCAN_order_n of 4x4 to 32x32 transforms (n = log2(size) - 1),\n")
	strings.write_string(out, "// in the order of Scan_Order: diagonal, horizontal, vertical.\n\n")
	for scan in 0 ..< 3 {
		for size in 1 ..< 5 {
			name := fmt.tprintf("SCAN_%d_%d", scan, size)
			values := c_ints(tables_c, fmt.tprintf("g_sig_last_scan_%d_%d", scan, size))
			expect(len(values) == 1 << uint(2 * size + 2), name)
			nested_table(out, "rodata", name, "u32", values, {len(values)})
		}
	}
	strings.write_string(out, "// Coefficient group scans of 8x8 (by scan order), 16x16 and 32x32 transforms.\n")
	nested_table(out, "rodata", "SCAN_CG_8X8", "u32", c_ints(tables_h, "g_sig_last_scan_8x8"), {3, 4})
	nested_table(out, "rodata", "SCAN_CG_16X16", "u32", c_ints(tables_h, "g_sig_last_scan_16x16"), {16})
	nested_table(out, "rodata", "SCAN_CG_32X32", "u32", c_ints(tables_h, "g_sig_last_scan_32x32"), {64})

	strings.write_string(out, "// The coefficient scan of a transform of size 1 << log2_size (2 to 5).\n")
	strings.write_string(out, "scan_table :: proc \"contextless\" (scan: Scan_Order, log2_size: int) -> []u32 {\n")
	strings.write_string(out, "\tswitch scan {\n")
	for order, scan in ([]string{"Diag", "Horizontal", "Vertical"}) {
		fmt.sbprintf(out, "\tcase .%s:\n\t\tswitch log2_size {{\n", order)
		for size in 2 ..= 5 do fmt.sbprintf(out, "\t\tcase %d:\n\t\t\treturn SCAN_%d_%d[:]\n", size, scan, size - 1)
		strings.write_string(out, "\t\t}\n")
	}
	strings.write_string(out, "\t}\n\treturn SCAN_0_1[:]\n}\n")
}
