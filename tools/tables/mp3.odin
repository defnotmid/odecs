package main

import "core:strings"

// mp3/tables.odin: normative MPEG audio Layer III data:
//   - minimp3 (CC0): the Huffman decoding tables in its packed lookup format
//     (tabs, tab32, tab33, tabindex, linbits), the scalefactor band widths
//     for the nine sample rates (long, short, mixed), and the MPEG-2
//     scalefactor partitions and modulo table;
//   - PDMP3 (public domain): the synthesis window D[512] of the standard.
mp3_tables :: proc(out: ^strings.Builder, third_party: string) {
	minimp3 := read(strings.concatenate({third_party, "/minimp3/minimp3.h"}))
	pdmp3 := read(strings.concatenate({third_party, "/PDMP3/pdmp3.c"}))

	strings.write_string(out, "// Generated by tools/tables from third_party/minimp3 (CC0) and\n")
	strings.write_string(out, "// third_party/PDMP3 (public domain); do not edit.\npackage mp3\n\n")

	table(out, "HUFFMAN", "i16", c_ints(minimp3, "tabs"), comment = {
			"Big-value Huffman tables in a multi-level lookup: an entry >= 0 is a leaf",
			"(bits used << 8 | y << 4 | x), a negative one links a subtable",
			"(-(offset << 3) | bits to peek). HUFFMAN_START[table] is each table's root.",
		})
	table(out, "HUFFMAN_START", "i16", c_ints(minimp3, "tabindex"))
	table(out, "LINBITS", "u8", c_ints(minimp3, "g_linbits"))
	table(out, "COUNT1_A", "u8", c_ints(minimp3, "tab32"), comment = {"Count1 tables A (32) and B (33), quadruples of one-bit values."})
	table(out, "COUNT1_B", "u8", c_ints(minimp3, "tab33"))

	BANDS :: [?]struct {
		c, odin: string,
		width:   int,
	}{{"g_scf_long", "SFB_LONG", 23}, {"g_scf_short", "SFB_SHORT", 40}, {"g_scf_mixed", "SFB_MIXED", 40}}
	for t in BANDS {
		values := padded_rows(minimp3, t.c, t.width)
		expect(len(values) == 8 * t.width, t.c)
		table(out, t.odin, "u8", values, shape = {8, t.width}, comment = {
				"Scalefactor band widths (zero-terminated) per rate row: 0: 11.025 and",
				"12 kHz (MPEG-2.5), 1: 8, 2: 22.05 (MPEG-2), 3: 24, 4: 16, 5: 44.1 (MPEG-1),",
				"6: 48, 7: 32.",
			})
	}
	table(out, "SCF_PARTITIONS", "u8", padded_rows(minimp3, "g_scf_partitions", 28), shape = {3, 28}, comment = {
			"MPEG-2 scalefactor counts per partition: long, short, mixed blocks,",
			"each 7 groups of 4 (the group follows from scalefac_compress).",
		})
	table(out, "SCF_MOD", "u8", c_ints(minimp3, "g_mod"), comment = {"MPEG-2 scalefac_compress decoding moduli (ISO/IEC 13818-3 table)."})
	table(out, "SCF_COMPRESS", "u8", c_ints(minimp3, "g_scfc_decode"), comment = {"MPEG-1 scalefac_compress to (slen1 << 2 | slen2)."})

	window := c_floats(pdmp3, "g_synth_dtbl")
	expect(len(window) == 512, "g_synth_dtbl")
	table(out, "SYNTH_WINDOW", "f32", window, per_line = 8, comment = {"The synthesis window D[i] of the standard (table B.3 of ISO/IEC 11172-3)."})
}

// A 2-D initializer's rows, each zero-padded to width as C does.
padded_rows :: proc(source, name: string, width: int) -> []i64 {
	body := initializer(source, name)
	out := make([dynamic]i64)
	for i := 0; i < len(body); i += 1 {
		if body[i] != '{' do continue
		end := strings.index_any(body[i + 1:], "{}")
		if end < 0 || body[i + 1 + end] != '}' do continue
		row := items(body[i + 1:][:end], C_SEPARATORS)
		expect(len(row) <= width, name)
		for v in row do append(&out, c_int(v))
		for _ in len(row) ..< width do append(&out, 0)
		i += end + 1
	}
	return out[:]
}
