package main

import "core:strings"

// opus/tables.odin: normative data of RFC 6716's CELT layer for the
// standard 48 kHz mode (shortMdctSize 120, overlap 120), from libopus:
//   - modes.c: band edges (eband5ms) and the allocation vectors;
//   - static_modes_float.h: logN, the pulse cache (index, bits, caps) and the MDCT window;
//   - quant_bands.c: the coarse energy Laplace models and the band means;
//   - celt.c, celt.h, rate.c: the TF selection table and small ICDFs;
//   - cwrs.c: the PVQ codebook sizes U(N, K), rows flattened with offsets.
opus_tables :: proc(out: ^strings.Builder, third_party: string) {
	dir := strings.concatenate({third_party, "/opus/celt/"})
	file :: proc(dir, name: string) -> string {return read(strings.concatenate({dir, name}))}
	modes := file(dir, "modes.c")
	static_modes := file(dir, "static_modes_float.h")
	quant_bands := file(dir, "quant_bands.c")

	strings.write_string(out, "// Generated by tools/tables from third_party/opus (libopus 1.6.1,\n")
	strings.write_string(out, "// BSD-3-Clause); do not edit.\npackage opus\n\n")

	ebands := c_ints(modes, "eband5ms")
	expect(len(ebands) == 22, "eband5ms")
	table(out, "EBANDS", "i16", ebands, per_line = 22, comment = {"Band edges in 5 ms (120-bin) units: band i is EBANDS[i] ..< EBANDS[i+1]."})
	table(out, "BAND_ALLOCATION", "u8", c_ints(modes, "band_allocation"), shape = {11, 21}, comment = {"Static allocation vectors in 1/32 bit per sample, 11 quality levels by band."})

	table(out, "LOG_N", "i16", c_ints(static_modes, "logN400"), per_line = 21, comment = {"log2 of each band's width in 1/8 bits."})
	table(out, "CACHE_INDEX", "i16", c_ints(static_modes, "cache_index50"), shape = {5, 21}, comment = {"Pulse cache: per LM+1 (0 is the N=1 split case) and band, the offset of", "its bits row in CACHE_BITS (-1 for none)."})
	table(out, "CACHE_BITS", "u8", c_ints(static_modes, "cache_bits50"), comment = {"Pulse cache rows: count, then the bits (1/8, minus one) for 1..count pulses."})
	table(out, "CACHE_CAPS", "u8", c_ints(static_modes, "cache_caps50"), shape = {8, 21}, comment = {"Maximum band allocation per (2*LM + C - 1) and band."})
	window := c_floats(static_modes, "window120")
	expect(len(window) == 120, "window120")
	table(out, "WINDOW", "f32", window, per_line = 6, comment = {"The MDCT overlap window (power-complementary), 120 samples."})

	table(out, "E_PROB_MODEL", "u8", c_ints(quant_bands, "e_prob_model"), shape = {4, 2, 42}, comment = {"Coarse energy Laplace models per LM, inter/intra: (P(0), decay) pairs in Q8."})
	// quant_bands.c defines eMeans for the fixed-point build first.
	means := items(float_means(quant_bands), C_SEPARATORS)
	e_means := make([]f64, len(means))
	for v, i in means do e_means[i] = c_float(v)
	table(out, "E_MEANS", "f32", e_means, per_line = 5, comment = {"Mean band log energies (log2 units) added back when denormalising."})

	table(out, "TF_SELECT", "i8", c_ints(file(dir, "celt.c"), "tf_select_table"), shape = {4, 8}, comment = {"TF resolution changes per LM: [4*transient + 2*tf_select + tf_res]."})
	table(out, "LOG2_FRAC", "u8", c_ints(file(dir, "rate.c"), "LOG2_FRAC_TABLE"), per_line = 24, comment = {"Bits (1/8) to code an intensity band index among 0 ..< n, by n."})
	celt_h := file(dir, "celt.h")
	table(out, "TRIM_ICDF", "u8", c_ints(celt_h, "trim_icdf"), per_line = 11)
	table(out, "SPREAD_ICDF", "u8", c_ints(celt_h, "spread_icdf"), per_line = 11)
	table(out, "TAPSET_ICDF", "u8", c_ints(celt_h, "tapset_icdf"), per_line = 11)

	// The PVQ codebook sizes: row I of U(N, K) holds K >= I from offset
	// PVQ_ROW[I], so U(n, k) = PVQ_U[PVQ_ROW[min] + max]: the rows the
	// standard modes need, without Opus Custom's CWRS_EXTRA_ROWS.
	cwrs := without_extra_rows(file(dir, "cwrs.c"))
	pvq_u := c_ints(cwrs, "CELT_PVQ_U_DATA")
	expect(len(pvq_u) == 1272, "CELT_PVQ_U_DATA")
	table(out, "PVQ_U", "u32", pvq_u, per_line = 8, comment = {"PVQ codebook sizes U(N, K) (RFC 6716 4.3.4.1) for the band sizes of the", "standard modes; V(N, K) = U(N, K) + U(N, K + 1) codewords."})
	table(out, "PVQ_ROW", "i16", pvq_rows(cwrs), per_line = 15)
}

// The body of the float build's `const opus_val16 eMeans[25] = { ... };`.
float_means :: proc(source: string) -> string {
	DECLARATION :: "const opus_val16 eMeans[25]"
	from := 0
	for {
		at := strings.index(source[from:], DECLARATION)
		expect(at >= 0, "eMeans")
		from += at + len(DECLARATION)
		i := skip_space(source, from)
		if i >= len(source) || source[i] != '=' do continue
		i = skip_space(source, i + 1)
		if i >= len(source) || source[i] != '{' do continue
		end := strings.index(source[i:], "};")
		expect(end >= 0, "eMeans")
		return source[i + 1:][:end - 1]
	}
}

// The offsets of CELT_PVQ_U_ROW's row pointers into CELT_PVQ_U_DATA.
pvq_rows :: proc(cwrs: string) -> []i64 {
	POINTER :: "CELT_PVQ_U_DATA+"
	rest := cwrs[strings.index(cwrs, "CELT_PVQ_U_ROW[15]"):]
	rows := make([dynamic]i64)
	for len(rows) < 15 {
		at := strings.index(rest, POINTER)
		expect(at >= 0, "CELT_PVQ_U_ROW")
		i := skip_space(rest, at + len(POINTER))
		start := i
		for i < len(rest) && is_digit(rest[i]) do i += 1
		if i > start do append(&rows, c_int(rest[start:i]))
		rest = rest[i:]
	}
	expect(rows[0] == 0, "CELT_PVQ_U_ROW")
	return rows[:]
}

// source without its `#if defined(CWRS_EXTRA_ROWS)` branches (keeping their
// #else branches).
without_extra_rows :: proc(source: string) -> string {
	out := strings.builder_make()
	skip := make([dynamic]bool)
	text := source
	for line in strings.split_lines_iterator(&text) {
		t := strings.trim_space(line)
		switch {
		case strings.has_prefix(t, "#if defined(CWRS_EXTRA_ROWS)"):
			append(&skip, true)
			continue
		case len(skip) > 0 && strings.has_prefix(t, "#else"):
			skip[len(skip) - 1] = false
			continue
		case len(skip) > 0 && strings.has_prefix(t, "#endif"):
			pop(&skip)
			continue
		}
		if len(skip) == 0 || !skip[len(skip) - 1] {
			strings.write_string(&out, line)
			strings.write_byte(&out, '\n')
		}
	}
	return strings.to_string(out)
}
