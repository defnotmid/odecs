package main

import "core:strings"

// codec/opus/silk_tables.odin: normative data of RFC 6716's SILK layer (and
// its resampler) from libopus. Jagged tables are laid out as CSR: one flat
// array of values and an array of row offsets (row r is
// values[at[r] ..< at[r+1]]), in place of libopus's arrays of row pointers.
// The two NLSF codebooks are concatenated the same way.
silk_tables :: proc(out: ^strings.Builder, third_party: string) {
	FILES :: [?]string {
		"tables_other.c", "tables_gain.c", "tables_LTP.c", "tables_pitch_lag.c",
		"tables_pulses_per_block.c", "tables_NLSF_CB_NB_MB.c", "tables_NLSF_CB_WB.c",
		"pitch_est_tables.c", "resampler_rom.c", "resampler_rom.h", "table_LSF_cos.c",
	}
	dir := strings.concatenate({third_party, "/opus/silk/"})
	texts: [len(FILES)]string
	for name, i in FILES do texts[i] = read(strings.concatenate({dir, name}))
	src := Silk_Source{strings.join(texts[:], "\n"), defines(read(strings.concatenate({dir, "define.h"})))}

	strings.write_string(out, "// Generated by tools/tables from third_party/opus (libopus 1.6.1,\n")
	strings.write_string(out, "// BSD-3-Clause); do not edit.\npackage opus\n\n")

	// Frame type, gains, LBRR.
	SMALL :: [?][2]string {
		{"silk_type_offset_VAD_iCDF", "TYPE_OFFSET_VAD_ICDF"}, {"silk_type_offset_no_VAD_iCDF", "TYPE_OFFSET_NO_VAD_ICDF"},
		{"silk_delta_gain_iCDF", "DELTA_GAIN_ICDF"}, {"silk_uniform3_iCDF", "UNIFORM3_ICDF"}, {"silk_uniform4_iCDF", "UNIFORM4_ICDF"},
		{"silk_uniform5_iCDF", "UNIFORM5_ICDF"}, {"silk_uniform6_iCDF", "UNIFORM6_ICDF"}, {"silk_uniform8_iCDF", "UNIFORM8_ICDF"},
		{"silk_NLSF_EXT_iCDF", "NLSF_EXT_ICDF"}, {"silk_NLSF_interpolation_factor_iCDF", "NLSF_INTERP_ICDF"},
		{"silk_pitch_delta_iCDF", "PITCH_DELTA_ICDF"}, {"silk_pitch_lag_iCDF", "PITCH_LAG_ICDF"},
		{"silk_LTP_per_index_iCDF", "LTP_PER_INDEX_ICDF"}, {"silk_LTPscale_iCDF", "LTP_SCALE_ICDF"},
		{"silk_lsb_iCDF", "LSB_ICDF"}, {"silk_sign_iCDF", "SIGN_ICDF"}, {"silk_shell_code_table_offsets", "SHELL_OFFSETS"},
		{"silk_stereo_pred_joint_iCDF", "STEREO_PRED_JOINT_ICDF"}, {"silk_stereo_only_code_mid_iCDF", "STEREO_MID_ONLY_ICDF"},
	}
	for t in SMALL do table(out, t[1], "u8", silk(src, t[0]))
	table(out, "GAIN_ICDF", "u8", silk(src, "silk_gain_iCDF"), shape = {3, 8}, comment = {"Absolute gain MSBs per signal type."})
	csr(out, "LBRR_FLAGS_ICDF", "u8", {silk(src, "silk_LBRR_flags_2_iCDF"), silk(src, "silk_LBRR_flags_3_iCDF")}, {"LBRR flags of 2- and 3-frame packets (CSR)."})
	table(out, "LTP_SCALES_Q14", "i16", silk(src, "silk_LTPScales_table_Q14"))
	table(out, "QUANT_OFFSETS_Q10", "i16", silk(src, "silk_Quantization_Offsets_Q10"), shape = {2, 2}, comment = {"Excitation offsets by voicing and quantisation offset type."})
	table(out, "STEREO_PRED_Q13", "i16", silk(src, "silk_stereo_pred_quant_Q13"))

	// Pulses.
	table(out, "RATE_LEVELS_ICDF", "u8", silk(src, "silk_rate_levels_iCDF"), shape = {2, 9})
	table(out, "PULSES_PER_BLOCK_ICDF", "u8", silk(src, "silk_pulses_per_block_iCDF"), shape = {10, 18})
	shell := make([dynamic]i64)
	for name in ([]string{"silk_shell_code_table0", "silk_shell_code_table1", "silk_shell_code_table2", "silk_shell_code_table3"}) {
		append(&shell, ..silk(src, name))
	}
	table(out, "SHELL_ICDF", "u8", shell[:], shape = {4, 152}, comment = {"Shell coder splits by level (16, 8, 4, 2 samples); SHELL_OFFSETS[n] starts the iCDF for n pulses."})

	// LTP: three codebooks of 8, 16 and 32 five-tap filters.
	csr(out, "LTP_GAIN_ICDF", "u8", {silk(src, "silk_LTP_gain_iCDF_0"), silk(src, "silk_LTP_gain_iCDF_1"), silk(src, "silk_LTP_gain_iCDF_2")}, {"LTP filter index iCDF per periodicity index (CSR)."})
	csr(out, "LTP_VQ_Q7", "i8", {silk(src, "silk_LTP_gain_vq_0"), silk(src, "silk_LTP_gain_vq_1"), silk(src, "silk_LTP_gain_vq_2")}, {"LTP filters (5 taps, Q7) per periodicity index (CSR, offsets in filters)."}, width = 5)

	// Pitch.
	csr(out, "PITCH_CONTOUR_ICDF", "u8", {
			silk(src, "silk_pitch_contour_iCDF"), silk(src, "silk_pitch_contour_NB_iCDF"),
			silk(src, "silk_pitch_contour_10_ms_iCDF"), silk(src, "silk_pitch_contour_10_ms_NB_iCDF"),
		}, {"Pitch contour iCDFs (CSR): 20 ms, 20 ms narrowband, 10 ms, 10 ms narrowband."})
	csr(out, "PITCH_LAG_CB", "i8", {
			silk(src, "silk_CB_lags_stage3"), silk(src, "silk_CB_lags_stage2"),
			silk(src, "silk_CB_lags_stage3_10_ms"), silk(src, "silk_CB_lags_stage2_10_ms"),
		}, {"Pitch contour offsets per subframe (CSR, in the contour order above);", "row r is [subframes][size] with size = len / subframes."})

	// NLSF codebooks: NB/MB (order 10) then WB (order 16), concatenated.
	strings.write_string(out, "// The NLSF codebooks: 0 narrow/medium band (order 10), 1 wideband (16).\n")
	NLSF :: [?][4]string {
		{"CB1_Q8", "u8", "silk_NLSF_CB1_NB_MB_Q8", "silk_NLSF_CB1_WB_Q8"},
		{"CB1_WGHT_Q9", "i16", "silk_NLSF_CB1_Wght_Q9", "silk_NLSF_CB1_WB_Wght_Q9"},
		{"CB1_ICDF", "u8", "silk_NLSF_CB1_iCDF_NB_MB", "silk_NLSF_CB1_iCDF_WB"},
		{"PRED_Q8", "u8", "silk_NLSF_PRED_NB_MB_Q8", "silk_NLSF_PRED_WB_Q8"},
		{"CB2_SELECT", "u8", "silk_NLSF_CB2_SELECT_NB_MB", "silk_NLSF_CB2_SELECT_WB"},
		{"CB2_ICDF", "u8", "silk_NLSF_CB2_iCDF_NB_MB", "silk_NLSF_CB2_iCDF_WB"},
		{"DELTA_MIN_Q15", "i16", "silk_NLSF_DELTA_MIN_NB_MB_Q15", "silk_NLSF_DELTA_MIN_WB_Q15"},
	}
	for t in NLSF do csr(out, strings.concatenate({"NLSF_", t[0]}), t[1], {silk(src, t[2]), silk(src, t[3])}, nil)
	table(out, "NLSF_STEP_Q16", "i32", []i64{fix_const(0.18, 16), fix_const(0.15, 16)}, comment = {"Residual quantisation steps."})

	table(out, "LSF_COS_Q12", "i16", silk(src, "silk_LSFCosTab_FIX_Q12"), comment = {"cos(pi i / 128) in Q12, 129 entries."})

	// Resampler.
	up2 := make([dynamic]i64)
	append(&up2, ..silk(src, "silk_resampler_up2_hq_0"))
	append(&up2, ..silk(src, "silk_resampler_up2_hq_1"))
	table(out, "RESAMPLER_UP2_HQ", "i16", up2[:], shape = {2, 3}, comment = {"All-pass sections of the 2x upsampler (even, odd outputs)."})
	table(out, "RESAMPLER_FRAC_FIR_12", "i16", silk(src, "silk_resampler_frac_FIR_12"), shape = {12, 4}, comment = {"Half of the 8-tap fractional interpolation filters, 12 phases (symmetric)."})
}

Silk_Source :: struct {
	text:    string,
	defines: map[string]i64,
}

// A SILK table's values: integers, define.h names and arithmetic on them.
silk :: proc(src: Silk_Source, name: string) -> []i64 {
	values := items(strip_comments(initializer(src.text, name)), ",{}\n")
	out := make([]i64, len(values))
	for v, i in values do out[i] = evaluate(v, src.defines)
	return out
}

// SILK_FIX_CONST(x, q): x in Q(q), rounded.
fix_const :: proc(x: f64, q: uint) -> i64 {
	return i64(x * f64(i64(1) << q) + 0.5)
}

// The numeric `#define NAME value` lines of a header.
defines :: proc(header: string) -> map[string]i64 {
	out := make(map[string]i64)
	from := 0
	for {
		at := strings.index(header[from:], "#define")
		if at < 0 do return out
		i := from + at + len("#define")
		from = i
		if i >= len(header) || !is_space(header[i]) do continue
		i = skip_space(header, i)
		start := i
		for i < len(header) && is_word(header[i]) do i += 1
		name := header[start:i]
		if name == "" || i >= len(header) || !is_space(header[i]) do continue
		i = skip_space(header, i)
		start = i
		if i < len(header) && header[i] == '-' do i += 1
		digits := i
		for i < len(header) && is_digit(header[i]) do i += 1
		if i == digits || (i < len(header) && is_word(header[i])) do continue
		out[name] = c_int(header[start:i])
	}
}

// Rows of different lengths as values plus offsets (in rows of `width`).
csr :: proc(out: ^strings.Builder, name, kind: string, rows: [][]i64, comment: []string, width := 1) {
	values := make([dynamic]i64)
	at := make([dynamic]i64)
	append(&at, 0)
	for r in rows {
		append(&values, ..r)
		append(&at, i64(len(values) / width))
	}
	table(out, name, kind, values[:], comment = comment)
	table(out, strings.concatenate({name, "_AT"}), "u16", at[:], per_line = len(at))
}
