package h265_encoder

import common "../../common"
import "core:testing"

// Golden output generated by compiling kvazaar's cabac.c with the same bin
// sequence and initial context states (see tests/test_h265_cabac.md).
CABAC_GOLDEN := [75]u8 {
	0xd0,
	0x8f,
	0xf3,
	0x89,
	0x1e,
	0x23,
	0x13,
	0x51,
	0x4c,
	0x16,
	0x0e,
	0xd1,
	0x97,
	0x0e,
	0xf3,
	0xe3,
	0x83,
	0xdf,
	0xbe,
	0x49,
	0x7d,
	0x3a,
	0x54,
	0xf4,
	0x68,
	0x20,
	0x85,
	0x4e,
	0xa4,
	0xe3,
	0x3f,
	0xce,
	0x89,
	0xff,
	0x69,
	0x62,
	0x2c,
	0x03,
	0x9d,
	0x74,
	0x9c,
	0xfa,
	0xe6,
	0xe0,
	0xea,
	0x89,
	0x25,
	0xe4,
	0x54,
	0x49,
	0xd1,
	0x62,
	0x22,
	0xe6,
	0xd7,
	0x4a,
	0x50,
	0x79,
	0x52,
	0x21,
	0x80,
	0x58,
	0x0b,
	0xf4,
	0xae,
	0x8d,
	0xdf,
	0xa2,
	0x13,
	0xa6,
	0x20,
	0x09,
	0x7f,
	0xce,
	0x81,
}

@(test)
test_cabac_golden :: proc(t: ^testing.T) {
	buf: [dynamic]u8
	defer delete(buf)
	w := common.init_bit_writer(&buf)

	cabac: Cabac
	cabac.stream = &w
	cabac_start(&cabac)

	c1 := Cabac_Context {
		state = 40,
	}
	c2 := Cabac_Context {
		state = 97,
	}
	c3 := Cabac_Context {
		state = 0,
	}

	for i in 0 ..< 64 {
		cabac_bin(&cabac, &c1, u32(i & 1))
		cabac_bin(&cabac, &c2, u32((i >> 1) & 1))
		cabac_bin(&cabac, &c3, u32(i % 3 == 0 ? 1 : 0))
		cabac_bin_ep(&cabac, u32(i & 1))
		cabac_bins_ep(&cabac, u32(i * 7), 5)
	}
	cabac_bin_trm(&cabac, 1)
	cabac_finish(&cabac)

	testing.expectf(
		t,
		len(buf) == len(CABAC_GOLDEN),
		"got %d bytes, want %d",
		len(buf),
		len(CABAC_GOLDEN),
	)
	for b, i in buf {
		if b != CABAC_GOLDEN[i] {
			testing.expectf(t, false, "byte %d: got %02x, want %02x", i, b, CABAC_GOLDEN[i])
			return
		}
	}
}
